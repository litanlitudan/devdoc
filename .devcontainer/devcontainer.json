{
	"name": "Devdoc Development",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "..",
		"args": {
			"TZ": "${localEnv:TZ:America/Los_Angeles}",
			"CLAUDE_CODE_VERSION": "latest",
			"GIT_DELTA_VERSION": "0.18.2",
			"ZSH_IN_DOCKER_VERSION": "1.2.0"
		}
	},

	// Configure tool-specific properties
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "bash",
						"icon": "terminal-bash"
					},
					"zsh": {
						"path": "zsh"
					}
				},
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"editor.codeActionsOnSave": {
					"source.fixAll.eslint": "explicit"
				},
				"typescript.tsdk": "node_modules/typescript/lib",
				"files.exclude": {
					"**/node_modules": true,
					"**/dist": true,
					"**/.git": true
				}
			},
			"extensions": [
				"anthropic.claude-code",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"eamodio.gitlens",
				"ms-python.python",
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"bierner.markdown-mermaid",
				"yzhang.markdown-all-in-one"
			]
		}
	},

	// Use 'forwardPorts' to make ports available locally
	"forwardPorts": [8642, 3684, 35729],
	"portsAttributes": {
		"8642": {
			"label": "Devdoc App",
			"onAutoForward": "notify"
		},
		"3684": {
			"label": "MCP Server",
			"onAutoForward": "notify"
		},
		"35729": {
			"label": "LiveReload",
			"onAutoForward": "silent"
		}
	},

	// Remove old container before starting (runs on host)
	"initializeCommand": "docker rm -f devcontainer-devdoc 2>/dev/null || true",

	// Use 'postCreateCommand' to run commands after the container is created
	"postCreateCommand": "npm install",

	// Use 'postStartCommand' to run commands after the container starts
	"postStartCommand": "echo '🚀 Devdoc devcontainer ready! Claude Code is installed. Run make dev to start development.'",

	// Comment out to connect as root instead
	"remoteUser": "dev",

	// Fixed container name
	"runArgs": ["--name", "devcontainer-devdoc"],

	// Container environment variables
	"containerEnv": {
		"NODE_ENV": "development",
		"NODE_OPTIONS": "--max-old-space-size=4096",
		"LLVM_DIR": "/usr/lib/llvm-18",
		"CMAKE_PREFIX_PATH": "/usr/lib/llvm-18",
		"CLAUDE_CONFIG_DIR": "/home/dev/.claude",
		"POWERLEVEL9K_DISABLE_GITSTATUS": "true"
	},

	// Mount the local file system
	"mounts": [
		// Bash history persistence (volume)
		"source=devdoc-bashhistory,target=/commandhistory,type=volume",

		// Claude Code configuration (volume)
		"source=devdoc-claude-config,target=/home/dev/.claude,type=volume",

		// Optional: Git configuration from host (bind mount)
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/dev/.gitconfig,type=bind,consistency=cached"
	],

	// Workspace configuration
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
	"workspaceFolder": "/workspace"
}
